# Supabase values from Project Settings -> API / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_GRADING_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_SPEAKING_MODEL=gemini-3.7-flash
GEMINI_SPEAKING_VOICE=Kore

# Protect Vercel workers, licensed content import/moderation, and health probes.
CRON_SECRET=
CONTENT_IMPORT_SECRET=
HEALTHCHECK_SECRET=
PLATFORM_ADMIN_USER_IDS=

# Optional standards-based Web Push. Generate one VAPID key pair and keep the
# private key server-only. Subject must be a mailto: or https: URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WebRTC. Production should use server-issued TURN credentials.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SHARED_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional official/authorized learning sources. Never use personal tokens or
# scrape Facebook profiles, groups, comments, or pages you do not control.
COVOST_TSV_URL=
COVOST_PUBLIC_PROVENANCE_URL=https://ai.meta.com/tools/covost/
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0

# Real-service E2E tests are opt-in because they create and then expire real rooms.
E2E_REAL_SUPABASE=0
E2E_REAL_AI=0
E2E_BASE_URL=
